# Copy to .env and fill in. Never commit .env.
# mock = seeded data, no network. live = real Composio/Parallel/Slack.
# demo = live, and if a read fails or is slow the recorded cache answers (tagged "cached"); writes are never faked.
# demo-offline = no network: cached reads, writes simulated by the mock (tagged "simulated"). See docs/demo-day.md.
CHIEF_MODE=mock

# Any OpenAI-compatible host (Cline API, organizer credits, Together, Groq, Fireworks, local Ollama...)
# Cline API example (key: app.cline.bot > Settings > API Keys; model IDs look like provider/model):
#   CHIEF_LLM_BASE_URL=https://api.cline.bot/api/v1
#   CHIEF_LLM_MODEL=deepseek/deepseek-chat        (their docs also list minimax/minimax-m2.5 for free experimenting)
# Tool-calling quality varies by model: test it before relying on it on stage.
CHIEF_LLM_BASE_URL=
CHIEF_LLM_MODEL=
CHIEF_LLM_API_KEY=

# Composio (calendar, Gmail)
COMPOSIO_API_KEY=
CHIEF_USER_ID=chief-demo
# Optional: IANA zone for calendar times (default is this machine's time zone), and which calendar to use
CHIEF_TIMEZONE=
CHIEF_CALENDAR_ID=primary

# Parallel (live web search)
PARALLEL_API_KEY=
# Optional: comma-separated domains to restrict every web search to, e.g. caltrain.com,511.org
CHIEF_SEARCH_DOMAINS=

# Slack (Socket Mode: no public URL needed)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=

# Speech to text (Whisper on an OpenAI-compatible host)
CHIEF_STT_BASE_URL=https://api.groq.com/openai/v1
CHIEF_STT_API_KEY=
CHIEF_STT_MODEL=whisper-large-v3-turbo

# Phone page access token (keep the tunnel link private)
CHIEF_WEB_TOKEN=

# Real windows on stage (chief/screen.py): opens the real Gmail / Calendar / source pages as Chief works.
# Default off. Same as `--show-windows`. See docs/screen-setup.md. Sign in once with: python -m chief show-login
CHIEF_SHOW_WINDOWS=0
# Dedicated browser profile (holds the TEST Google account only). Default: .chief/browser-profile
CHIEF_SHOW_PROFILE_DIR=
# Full path to chrome.exe or msedge.exe; empty = find Chrome, then Edge
CHIEF_SHOW_BROWSER=
# New window size and position, e.g. 1280x800 and 1920,0 (second monitor to the right of the main one)
CHIEF_SHOW_WINDOW_SIZE=
CHIEF_SHOW_WINDOW_POS=
# Optional: reload the Calendar tab in place via the DevTools port instead of opening another window (e.g. 9222)
CHIEF_SHOW_DEBUG_PORT=
# 1 = print the URLs that would open instead of opening a browser
CHIEF_SHOW_DRY_RUN=0

# Demo account seeding (scripts/seed_demo_account.py, docs/demo-account.md). TEST Google account only, never a personal one.
# The address must be a gmail.com address containing "demo". The app password is a Google app password (2-Step Verification
# on), never your normal password. Both are read from the environment only; the script never takes them as arguments.
CHIEF_DEMO_GMAIL=
CHIEF_DEMO_APP_PASSWORD=

# Folders Chief may list and open on this machine (open_folder / open_file; see docs/local-actions.md).
# Separate several with ";". Empty = only the project's demo/ folder (Desktop, Documents and Downloads are opt-in:
# real file names would show up on the projector). Example: CHIEF_LOCAL_ROOTS=C:\Users\you\Desktop\ChiefDemo
# A drive root or your whole home folder is ignored. Chief's own .chief/briefs is always allowed.
CHIEF_LOCAL_ROOTS=

# Demo failover (docs/demo-day.md). Seconds a live read may take before the cache answers (default 6).
CHIEF_LIVE_TIMEOUT=
# Where `python -m chief record-demo` saves the cache. Default: data/demo_cache.json (contains test-account snippets: do not commit)
CHIEF_DEMO_CACHE=
