   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Reads run freely. Every write\n(calendar edit, send email)\nwaits for an Approve tap. Email,\nweb and calendar text is\nuntrusted data. Skills get read\ntools only and can only propose\ntools they declared.",
   "originalText": "Reads run freely. Every write\n(calendar edit, send email)\nwaits for an Approve tap. Email,\nweb and calendar text is\nuntrusted data. Skills get read\ntools only and can only propose\ntools they declared.",
   "fontSize": 11.5,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
